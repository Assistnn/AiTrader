# ==============================================
# AI Trading System - Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.

# --- Application ---
DEBUG=false
LOG_LEVEL=INFO

# --- Trading Mode ---
# live: 本番取引
# simulation: ペーパートレード（本番価格 + MockExchange）
# backtest: バックテスト（HistoricalData + MockExchange）
TRADING_MODE=simulation

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_trading

# --- Security ---
JWT_SECRET_KEY=your-jwt-secret-key-here
MASTER_ENCRYPTION_KEY=your-master-encryption-key-here

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
